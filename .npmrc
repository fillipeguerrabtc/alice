# =============================================================================
# Configuração pnpm para Alice Enterprise Platform
# =============================================================================
# Documentação: https://pnpm.io/npmrc
# =============================================================================

# pnpm v10 breaking change: deploy de workspaces requer esta configuração
# Sem isso, "pnpm deploy" falha com ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE
# Referência: https://pnpm.io/cli/deploy
inject-workspace-packages=true

# Garantir lockfile consistente entre ambientes
frozen-lockfile=true

# Usar cache compartilhado para builds mais rápidos
prefer-frozen-lockfile=true

# Modo strict para evitar dependências fantasmas
strict-peer-dependencies=false
auto-install-peers=true
