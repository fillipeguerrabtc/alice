# pnpm v10+: por padrão, scripts de build (preinstall/install/postinstall) de dependências
# podem ser bloqueados e exigir aprovação explícita (`pnpm approve-builds`).
#
# Decisão do projeto (CI/deploy): permitir execução automática de TODOS os scripts necessários.
# ATENÇÃO: isso reduz a proteção contra supply-chain em dependências transitivas.
dangerously-allow-all-builds=true

# =============================================================================
# Configuração pnpm para Alice Enterprise Platform
# =============================================================================
# Documentação: https://pnpm.io/npmrc
# =============================================================================

# pnpm v10 breaking change: deploy de workspaces requer esta configuração
# Sem isso, "pnpm deploy" falha com ERR_PNPM_DEPLOY_NONINJECTED_WORKSPACE
# Referência: https://pnpm.io/cli/deploy
inject-workspace-packages=true

# Garantir lockfile consistente entre ambientes
frozen-lockfile=true

# Usar cache compartilhado para builds mais rápidos
prefer-frozen-lockfile=true

# Modo strict para evitar dependências fantasmas
strict-peer-dependencies=false
auto-install-peers=true

# Forçar hoisting de pacotes críticos para evitar duplicação
# Resolve conflitos de tipos entre versões duplicadas do drizzle-orm
public-hoist-pattern[]=*types*
public-hoist-pattern[]=drizzle-orm
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom

# Dedupe agressivo para monorepo
dedupe-peer-dependents=true
