# ==============================================================================
# Alice Enterprise Platform - EditorConfig (Consistência de Edição)
# ==============================================================================
# Best practices 2025:
# - EOL determinístico
# - UTF-8
# - Final newline
# - Sem trailing whitespace (exceto Markdown)
#
# Autor: Fillipe Guerra
# Data: 26 de Dezembro de 2025
# ==============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

