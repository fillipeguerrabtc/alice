          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "Artifact: infra/scripts/setup-ssh-key.sh\nType: \nSecret Asymmetric Private Key\nSeverity: HIGH\nMatch: BEGIN OPENSSH PRIVATE KEY-----******************************************************************************************************************************************************************************************************************************************************************************************************************************************************-----END OPENSSH PRI"
          },
          "locations": [
            {
              "physicalLocation": {
