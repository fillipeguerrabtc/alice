    "pgvector": "^0.2.1"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.39.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "@types/pg": "^8.12.0",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.9.3"
