{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "../../.cache/typescript/packages/database/tsconfig.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@alice/shared": ["../shared/src/index.ts"],
      "@alice/shared/*": ["../shared/src/*"],
      "@alice/logger": ["../logger/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../shared" },
    { "path": "../logger" }
  ],
  "exclude": ["node_modules", "dist"]
}
