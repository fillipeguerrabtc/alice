{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "tsBuildInfoFile": "../../.cache/typescript/packages/shared-utils/tsconfig.tsbuildinfo",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@alice/config": ["../config/src/index.ts"],
      "@alice/logger": ["../logger/src/index.ts"],
      "@alice/database": ["../database/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../config" },
    { "path": "../logger" },
    { "path": "../database" }
  ],
  "exclude": ["node_modules", "dist"]
}
