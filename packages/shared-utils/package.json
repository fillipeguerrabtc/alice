{
  "name": "@alice/shared-utils",
  "version": "1.0.0",
  "description": "Utilitários compartilhados para Alice Enterprise Platform",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./circuit-breaker": {
      "types": "./dist/circuit-breaker.d.ts",
      "import": "./dist/circuit-breaker.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "import": "./dist/audit.js"
    },
    "./metrics": {
      "types": "./dist/metrics.d.ts",
      "import": "./dist/metrics.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "import": "./dist/health.js"
    },
    "./rbac": {
      "types": "./dist/rbac/index.d.ts",
      "import": "./dist/rbac/index.js"
    },
    "./async-context": {
      "types": "./dist/async-context.d.ts",
      "import": "./dist/async-context.js"
    },
    "./prometheus": {
      "types": "./dist/prometheus.d.ts",
      "import": "./dist/prometheus.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alice/database": "workspace:*",
    "@alice/logger": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "compression": "^1.8.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "opossum": "^9.0.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.0",
    "redis": "^5.10.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/opossum": "^8.1.9",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "express": "^4.21.2"
  }
}
