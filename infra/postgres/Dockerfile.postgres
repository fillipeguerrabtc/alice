# =============================================================================
# PostgreSQL + pgvector + pgBackRest - Alice Enterprise Platform
# =============================================================================
# Imagem enterprise PostgreSQL com:
# - pgvector: Extensão para embeddings vetoriais (texto)
# - pgBackRest: Backup enterprise com PITR, WAL archiving, criptografia AES-256
#
# CORREÇÃO CRÍTICA 31/12/2025:
# Migrado de pgvector/pgvector:pg16 (Debian) para postgres:16-alpine + pgvector
# MOTIVO: CVE-2023-45853 (CRITICAL) em zlib1g do Debian 12 - status "will_not_fix"
# Alpine Linux usa zlib 1.3.1+ que já corrigiu esta vulnerabilidade.
#
# Author: Fillipe Guerra
# Data: 31 de Dezembro de 2025
#
# Regra 6: Enterprise-grade (sem workarounds, sem CVEs)
# Regra 11: Seguir docs oficiais pgBackRest + pgvector 2025
# =============================================================================

# =============================================================================
# Stage 1: Build pgBackRest from source (Alpine)
# =============================================================================
FROM alpine:3.21 AS pgbackrest-builder

# Versão do pgBackRest (deve corresponder à versão do container pgbackrest)
ARG PGBACKREST_VERSION=2.57.0

# Instalar dependências de build
RUN apk add --no-cache \
    meson \
    gcc \
    musl-dev \
    libpq-dev \
    openssl-dev \
    libxml2-dev \
    lz4-dev \
    zstd-dev \
    bzip2-dev \
    yaml-dev \
    libssh2-dev \
    make \
    ninja \
    git

# Clone e build pgBackRest
RUN git clone --branch release/${PGBACKREST_VERSION} --depth 1 \
    https://github.com/pgbackrest/pgbackrest.git /tmp/pgbackrest

WORKDIR /tmp/pgbackrest
RUN meson setup build --prefix=/usr
RUN ninja -C build
RUN ninja -C build install

# =============================================================================
# Stage 2: Build pgvector from source
# Usa postgres:16-alpine como base para ter os headers corretos
# =============================================================================
FROM postgres:16-alpine AS pgvector-builder

# Versão do pgvector (latest stable)
ARG PGVECTOR_VERSION=0.8.0

# Instalar dependências de build para pgvector
# NOTA: PostgreSQL Alpine usa clang para JIT, precisamos dos headers de desenvolvimento
RUN apk add --no-cache \
    build-base \
    clang19 \
    clang19-dev \
    llvm19 \
    llvm19-dev \
    git

# Clone pgvector
RUN git clone --branch v${PGVECTOR_VERSION} --depth 1 \
    https://github.com/pgvector/pgvector.git /tmp/pgvector

WORKDIR /tmp/pgvector

# =============================================================================
# CORREÇÃO CRÍTICA 01/01/2026: Flags de compilação compatíveis com CPU i5-13500
# =============================================================================
# PROBLEMA: Build em GitHub Actions (CPU moderna) gerava binário com AVX-512
# CAUSA: CPU do runner suporta AVX-512, mas servidor Hetzner (i5-13500) NÃO suporta
# ERRO: "signal 4: Illegal instruction" ao executar CREATE EXTENSION vector
# 
# SOLUÇÃO: Usar -march=x86-64-v3 que inclui:
#   - SSE, SSE2, SSE3, SSSE3, SSE4.1, SSE4.2
#   - AVX, AVX2, BMI1, BMI2, F16C, FMA, LZCNT, MOVBE, XSAVE
#   - NÃO inclui AVX-512 (não suportado pelo i5-13500)
#
# REFERÊNCIA: https://gcc.gnu.org/onlinedocs/gcc/x86-Options.html
# =============================================================================
ENV CFLAGS="-O3 -march=x86-64-v3 -mtune=generic -fno-omit-frame-pointer"
ENV CXXFLAGS="-O3 -march=x86-64-v3 -mtune=generic -fno-omit-frame-pointer"
ENV OPTFLAGS="-O3 -march=x86-64-v3 -mtune=generic"

# Build pgvector com flags explícitas
# NOTA: PG_CFLAGS passa flags diretamente para o compilador do PostgreSQL extension
RUN make clean 2>/dev/null || true && \
    make PG_CONFIG=/usr/local/bin/pg_config PG_CFLAGS="$CFLAGS" OPTFLAGS="$OPTFLAGS" && \
    make install PG_CONFIG=/usr/local/bin/pg_config

# =============================================================================
# Stage 3: Runtime - PostgreSQL Alpine + pgvector + pgBackRest
# =============================================================================
FROM postgres:16-alpine

LABEL maintainer="Alice Enterprise Platform <admin@yesyoudeserve.duckdns.org>"
LABEL description="PostgreSQL 16 + pgvector + pgBackRest (enterprise backup with PITR)"
LABEL version="2.0.0"

# Variáveis de ambiente PostgreSQL
ENV POSTGRES_USER=postgres
ENV PGDATA=/var/lib/postgresql/data

# Copiar pgvector do builder stage
# NOTA: Extensões PostgreSQL ficam em /usr/local/lib/postgresql/ e /usr/local/share/postgresql/extension/
COPY --from=pgvector-builder /usr/local/lib/postgresql/vector.so /usr/local/lib/postgresql/
COPY --from=pgvector-builder /usr/local/share/postgresql/extension/vector* /usr/local/share/postgresql/extension/

# Instalar dependências runtime do pgBackRest + LLVM runtime para pgvector JIT
USER root
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    # pgBackRest runtime dependencies
    openssl \
    libxml2 \
    lz4-libs \
    zstd-libs \
    libbz2 \
    yaml \
    libssh2 \
    libpq \
    ca-certificates \
    # LLVM runtime para pgvector JIT (se compilado com suporte)
    llvm19-libs \
    && rm -rf /var/cache/apk/*

# Copiar binário pgBackRest do stage builder
COPY --from=pgbackrest-builder /usr/bin/pgbackrest /usr/bin/pgbackrest
RUN chmod +x /usr/bin/pgbackrest

# Criar diretórios necessários para pgBackRest
RUN mkdir -p /var/lib/pgbackrest \
    && mkdir -p /var/log/pgbackrest \
    && mkdir -p /var/spool/pgbackrest \
    && mkdir -p /etc/pgbackrest \
    && chown -R postgres:postgres /var/lib/pgbackrest \
    && chown -R postgres:postgres /var/log/pgbackrest \
    && chown -R postgres:postgres /var/spool/pgbackrest \
    && chown -R postgres:postgres /etc/pgbackrest

# Copiar configuração pgBackRest para PostgreSQL
COPY pgbackrest-pg.conf /etc/pgbackrest/pgbackrest.conf
RUN chown postgres:postgres /etc/pgbackrest/pgbackrest.conf

# =============================================================================
# Script de inicialização para criar extensão pgvector com validação
# CORREÇÃO 01/01/2026: Fail-fast se extensão não for criada corretamente
# =============================================================================
RUN mkdir -p /docker-entrypoint-initdb.d && \
    cat > /docker-entrypoint-initdb.d/00-create-pgvector.sh << 'EOSCRIPT'
#!/bin/bash
set -e

echo "🔌 [postgres-init] Criando extensão pgvector..."

# Criar extensão
psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" <<-EOSQL
    CREATE EXTENSION IF NOT EXISTS vector;
EOSQL

# Validar se extensão foi criada
VECTOR_EXISTS=$(psql -t -A --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" -c "SELECT COUNT(*) FROM pg_extension WHERE extname = 'vector';")
if [ "$VECTOR_EXISTS" != "1" ]; then
    echo "❌ [postgres-init] ERRO CRÍTICO: Extensão pgvector NÃO foi criada!" >&2
    exit 1
fi

echo "✅ [postgres-init] Extensão pgvector criada"

# Testar operação vetorial (detectar SIGILL em runtime)
echo "🧪 [postgres-init] Testando operações pgvector..."
if psql -v ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" -c "SELECT '[1,2,3]'::vector <-> '[3,2,1]'::vector;" > /dev/null 2>&1; then
    echo "✅ [postgres-init] Operações pgvector funcionando corretamente"
else
    echo "❌ [postgres-init] ERRO CRÍTICO: SIGILL detectado em operações pgvector!" >&2
    echo "   CPU do servidor não suporta instruções usadas pelo binário pgvector" >&2
    exit 1
fi

echo "✅ [postgres-init] pgvector inicializado com sucesso!"
EOSCRIPT
RUN chmod +x /docker-entrypoint-initdb.d/00-create-pgvector.sh && \
    chown postgres:postgres /docker-entrypoint-initdb.d/00-create-pgvector.sh

# =============================================================================
# FASE 2: Entrypoint Wrapper com Validação de Permissões (09/01/2026)
# =============================================================================
# PROPÓSITO: Fail-fast se diretório PGDATA não tem permissões corretas
# BENEFÍCIO: Erro claro e acionável ao invés de "Permission denied" genérico
#
# REFERÊNCIAS:
#   - CLAUDE.md Regra 6 (Enterprise-grade, sem workarounds)
#   - CLAUDE.md Regra 9 (Validação contínua)
#   - CLAUDE.md Regra 16 (Fail-fast)
#
# Author: Fillipe Guerra
# Data: 09 de Janeiro de 2026
# =============================================================================

# Copiar entrypoint wrapper com validação de permissões
COPY entrypoint-wrapper.sh /usr/local/bin/entrypoint-wrapper.sh
RUN chmod +x /usr/local/bin/entrypoint-wrapper.sh

# Voltar ao usuário postgres (padrão da imagem base)
USER postgres

# Substituir entrypoint padrão pelo wrapper com validação
# O wrapper executa validações e depois chama docker-entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint-wrapper.sh"]
CMD ["postgres"]

# Healthcheck herdado da imagem base (pg_isready)
# O docker-compose.prod.yml sobrescreve com healthcheck mais avançado
