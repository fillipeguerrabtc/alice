# =============================================================================
# Mariabackup Container - Alice Enterprise Platform (ERPNext)
# =============================================================================
# Imagem enterprise para backup MariaDB com incremental e PITR
# Documentação: https://mariadb.com/kb/en/mariabackup/
#
# Regra 6: Enterprise-grade (sem workarounds)
# Regra 11: Seguir docs oficiais MariaDB 2025
# =============================================================================

FROM mariadb:11.4

LABEL maintainer="Alice Enterprise Platform"
LABEL description="Mariabackup enterprise backup for ERPNext"

# Instalar dependências
RUN apt-get update && apt-get install -y \
    mariadb-backup \
    pigz \
    pv \
    curl \
    cron \
    && rm -rf /var/lib/apt/lists/*

# Timezone Brasil
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Criar diretórios
RUN mkdir -p /var/backups/mariadb/full \
    && mkdir -p /var/backups/mariadb/incremental \
    && mkdir -p /var/log/mariabackup

# Copiar scripts
COPY scripts/mariabackup/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# Usuário não-root
RUN useradd -r -s /bin/false mariabackup \
    && chown -R mariabackup:mariabackup /var/backups/mariadb \
    && chown -R mariabackup:mariabackup /var/log/mariabackup

# Healthcheck
HEALTHCHECK --interval=60s --timeout=10s --start-period=10s --retries=3 \
    CMD ls /var/backups/mariadb/full/*.xbstream.gz 2>/dev/null || exit 1

VOLUME ["/var/backups/mariadb", "/var/log/mariabackup"]

ENTRYPOINT ["/usr/local/bin/mariabackup-entrypoint.sh"]
CMD ["cron", "-f"]
