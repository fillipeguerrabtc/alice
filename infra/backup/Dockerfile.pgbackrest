# =============================================================================
# pgBackRest Container - Alice Enterprise Platform
# =============================================================================
# Imagem enterprise para backup PostgreSQL com PITR
# Documentação: https://pgbackrest.org/
#
# Regra 6: Enterprise-grade (sem workarounds)
# Regra 11: Seguir docs oficiais pgBackRest 2025 - build from source
# =============================================================================

# Stage 1: Build pgBackRest from source
# REGRA 16: Usar SHA256 digest para segurança (imagens externas)
FROM alpine:3.20@sha256:21a3deaa0d32a8057914f36584b5288d2e5ecc984380bc0118285c70fa8c9300 AS builder

# Versão do pgBackRest (semantic versioning completo)
# REGRA 11: pgBackRest usa tags no formato release/X.Y.Z (ex: release/2.57.0) para releases estáveis
# NOTA: Não usar "vX.Y.Z" aqui — esse ref não existe no upstream e quebra o build.
# Versão pode ser passada via build-arg PGBACKREST_VERSION (automação via CI/CD)
# Fallback para versão estável conhecida se não fornecida
ARG PGBACKREST_VERSION=2.57.0
ENV PGBACKREST_VERSION=${PGBACKREST_VERSION}

# Instalar dependências de build
# REGRA 11: Alpine 3.15+ separou pacotes PostgreSQL
# libpq-dev é necessário para aplicações que linkam contra libpq (pgBackRest)
# postgresql-dev é apenas para construir extensões PostgreSQL
RUN apk add --no-cache \
    meson \
    gcc \
    musl-dev \
    libpq-dev \
    openssl-dev \
    libxml2-dev \
    lz4-dev \
    zstd-dev \
    bzip2-dev \
    yaml-dev \
    libssh2-dev \
    make \
    wget \
    tar \
    ninja \
    git

# Download e build pgBackRest from source
# REGRA 11: pgBackRest usa tags no formato release/X.Y.Z (ex: release/2.56.0) para releases estáveis
# Tags são imutáveis e garantem versão exata (melhor prática enterprise)
RUN git clone --branch release/${PGBACKREST_VERSION} --depth 1 \
    https://github.com/pgbackrest/pgbackrest.git /tmp/pgbackrest

# Build e instalar pgBackRest
WORKDIR /tmp/pgbackrest
RUN meson setup build
RUN ninja -C build
RUN ninja -C build install

# Stage 2: Runtime image (minimal)
# REGRA 16: Usar SHA256 digest para segurança (imagens externas)
FROM alpine:3.20@sha256:21a3deaa0d32a8057914f36584b5288d2e5ecc984380bc0118285c70fa8c9300

LABEL maintainer="Alice Enterprise Platform"
LABEL description="pgBackRest enterprise backup with PITR, encryption, S3 offsite"

# Copiar binário compilado do stage builder
# NOTA: Removido copy do man page (pgbackrest.1) para evitar falha quando o build
# upstream não gera/manifesta o arquivo no caminho padrão. Man page não é usada
# no runtime do container (apenas binário).
COPY --from=builder /usr/local/bin/pgbackrest /usr/local/bin/pgbackrest

# Instalar apenas dependências de runtime (sem build tools)
USER root
# Atualizar índice e pacotes para versões mais recentes (mitiga CVEs em zlib/libretls/busybox)
# CORREÇÃO 19/12/2025: Instalar pacotes de LIBS runtime ao invés de dev headers
# O binário pgbackrest foi linkado contra essas libs no build stage
# Erro anterior: "Error relocating pgbackrest: ZSTD_initCStream: symbol not found"
# Causa: pacotes lz4, zstd, bzip2 são metapacotes ou headers, não as libs runtime
# Solução: usar lz4-libs, zstd-libs, libbz2 (nomes corretos no Alpine)
RUN apk update && apk upgrade --no-cache && \
    apk add --no-cache \
    bash \
    curl \
    ca-certificates \
    openssl \
    tzdata \
    postgresql-client \
    libxml2 \
    lz4-libs \
    zstd-libs \
    libbz2 \
    yaml \
    libssh2 \
    libpq

# Configurar timezone Brasil
ENV TZ=America/Sao_Paulo

# Criar diretórios necessários
RUN mkdir -p /var/lib/pgbackrest \
    && mkdir -p /var/log/pgbackrest \
    && mkdir -p /var/spool/pgbackrest \
    && mkdir -p /etc/pgbackrest

# Copiar configuração
# NOTA: Build context é raiz do repositório, não o diretório do Dockerfile
COPY infra/backup/pgbackrest.conf /etc/pgbackrest/pgbackrest.conf

# Copiar scripts de automação (inclui healthcheck.sh)
COPY infra/backup/scripts/ /usr/local/bin/
RUN chmod +x /usr/local/bin/*.sh

# =============================================================================
# CORREÇÃO 29/12/2025: Usar UID 999 (mesmo do PostgreSQL)
# =============================================================================
# PROBLEMA: pgBackRest rodava como UID 1000, mas PostgreSQL usa UID 999
# Os arquivos do PostgreSQL têm permissões 700 (apenas owner pode ler)
# Isso causava erro: "unable to open file pg_control: Permission denied"
#
# SOLUÇÃO: Fazer pgBackRest rodar como o mesmo UID do PostgreSQL (999)
# Isso permite que pgBackRest leia os arquivos de dados para backup.
#
# NOTA: Em Alpine, o grupo 999 pode não existir, então criamos ambos.
# =============================================================================
RUN addgroup -g 999 postgres 2>/dev/null || true \
    && adduser -D -u 999 -G postgres pgbackrest \
    && chown -R pgbackrest:postgres /var/lib/pgbackrest \
    && chown -R pgbackrest:postgres /var/log/pgbackrest \
    && chown -R pgbackrest:postgres /var/spool/pgbackrest \
    && chown -R pgbackrest:postgres /etc/pgbackrest

USER pgbackrest

# Healthcheck
# NOTA: Docker não faz substituição de variáveis de ambiente em runtime no HEALTHCHECK
# O healthcheck no Dockerfile usa valor fixo alice_prod (padrão)
# O docker-compose.prod.yml sobrescreve este healthcheck com um que usa PGBACKREST_STANZA
# CORREÇÃO BUG #2: Healthcheck do docker-compose agora usa variável de ambiente corretamente
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD pgbackrest info --stanza=alice_prod --output=json || exit 1

# NOTA: VOLUME removido - usamos bind mounts explícitos no docker-compose.prod.yml
# Isso evita criação de volumes anônimos que são descartados a cada restart
# Os diretórios /var/lib/pgbackrest e /var/log/pgbackrest serão montados explicitamente
# no docker-compose para garantir persistência no volume Hetzner

# Comando padrão: servidor de arquivamento contínuo
# Stanza será definido via variável de ambiente no entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["archive-push"]