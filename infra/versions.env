# =============================================================================
# ALICE PLATFORM - VERSÕES DOS COMPONENTES DE INFRAESTRUTURA
# =============================================================================
# Single Source of Truth (SSOT) para versionamento de TODOS os componentes
# Atualizado: 25/01/2026
# Autor: Fillipe Guerra
# =============================================================================
# REGRA 6 (CLAUDE.md): Enterprise-grade - sem hardcoded, versionado no Git
# REGRA 11: Seguir docs oficiais - versões alinhadas com 2025
# =============================================================================
# IMPORTANTE: TODAS as imagens públicas devem ter versão definida aqui
# Docker-compose files usam ${VAR:-default} para referenciar estas versões
# =============================================================================

# =============================================================================
# INFRA STACK - Componentes Base
# =============================================================================

# pgBackRest - Enterprise Backup para PostgreSQL
# Ref: https://pgbackrest.org/release.html
PGBACKREST_VERSION=2.57.0

# Caddy - Reverse Proxy com HTTPS automático + HTTP/3
# Ref: https://github.com/caddyserver/caddy/releases
CADDY_VERSION=2.10.0

# Redis - Cache distribuído (Alice)
# Ref: https://hub.docker.com/_/redis/tags
# NOTA: Alice usa 7.x, ERPNext requer 6.x (compatibilidade)
REDIS_ALICE_VERSION=7.4.7-alpine

# Qdrant - Banco Vetorial para Text Embeddings
# Ref: https://github.com/qdrant/qdrant/releases
QDRANT_VERSION=v1.16.2

# SearXNG - Metabusca self-hosted para Web Search
# Ref: https://hub.docker.com/r/searxng/searxng/tags
SEARXNG_VERSION=2025.12.30-a5c946a32

# MinIO - Object Storage S3-Compatible (Langfuse v3 requirement)
# NOTA (07/01/2026): MinIO descontinuou imagens oficiais Docker Hub em 23/10/2025
# Migração para Quay.io (registro oficial mantido pela MinIO)
# Ref: https://quay.io/repository/minio/minio
MINIO_IMAGE=quay.io/minio/minio
MINIO_VERSION=latest

# MinIO Client - CLI tool for bucket management
# Ref: https://quay.io/repository/minio/mc
MINIO_MC_IMAGE=quay.io/minio/mc
MINIO_MC_VERSION=latest

# PgBouncer - Connection Pooling for PostgreSQL
# Ref: https://github.com/pgbouncer/pgbouncer/releases
# NOTA CRÍTICA (08/01/2026): Bitnami descontinuou TODAS as imagens PgBouncer no Docker Hub
# Última versão Bitnami (1.25.1) removida em Set/2025, agora requer subscription comercial
# SOLUÇÃO ENTERPRISE: Migração para edoburu/pgbouncer (free, open-source, 10M+ pulls, atualizado 19 dias atrás)
# Vantagem: Env vars simples (DB_HOST, DB_PORT, etc) ao invés de DATABASES complexo
# Ref: https://hub.docker.com/r/edoburu/pgbouncer
# Ref: https://github.com/edoburu/docker-pgbouncer
PGBOUNCER_IMAGE=edoburu/pgbouncer
PGBOUNCER_VERSION=latest

# =============================================================================
# OBSERVABILITY STACK - Métricas, Logs, Tracing
# =============================================================================

# Prometheus - Métricas
# Ref: https://prometheus.io/download/
PROMETHEUS_VERSION=v3.8.1

# Grafana - Dashboards
# Ref: https://grafana.com/grafana/download
GRAFANA_VERSION=12.3.2

# Loki - Log Aggregation
# Ref: https://github.com/grafana/loki/releases
LOKI_VERSION=3.6.3

# Promtail - Log Collection
# Ref: https://github.com/grafana/loki/releases
PROMTAIL_VERSION=3.6.3

# Jaeger - Distributed Tracing
# Ref: https://www.jaegertracing.io/download/
JAEGER_VERSION=2.13.0

# Vector - Log Aggregator
# Ref: https://github.com/vectordotdev/vector/releases
VECTOR_VERSION=0.45.0-alpine

# OpenTelemetry Collector - Telemetry Pipeline
# Ref: https://github.com/open-telemetry/opentelemetry-collector-contrib/releases
OTEL_COLLECTOR_VERSION=0.142.0

# Node Exporter - Host Metrics
# Ref: https://github.com/prometheus/node_exporter/releases
NODE_EXPORTER_VERSION=v1.9.1

# cAdvisor - Container Metrics
# Ref: https://github.com/google/cadvisor/releases
CADVISOR_VERSION=v0.52.1

# mysqld_exporter - Métricas MariaDB/MySQL (ERPNext)
# Ref: https://github.com/prometheus/mysqld_exporter/releases
MYSQLD_EXPORTER_IMAGE=prom/mysqld-exporter
MYSQLD_EXPORTER_VERSION=v0.18.0

# ClickHouse - OLAP Database (Langfuse v3)
# Ref: https://hub.docker.com/r/clickhouse/clickhouse-server/tags
CLICKHOUSE_VERSION=25.12-alpine

# PostgreSQL (Langfuse DB) - Separate from main Alice PostgreSQL
# Ref: https://hub.docker.com/_/postgres/tags
POSTGRES_LANGFUSE_VERSION=16-alpine

# Langfuse - LLM Observability (versão v3 com ClickHouse)
# Ref: https://github.com/langfuse/langfuse/releases
LANGFUSE_VERSION=3.85.0

# Langfuse Worker - Async Processing
# Ref: https://github.com/langfuse/langfuse/releases
LANGFUSE_WORKER_VERSION=3.85.0

# =============================================================================
# BACKUP / MONITORING EXPORTERS
# =============================================================================

# pgBackRest Exporter - Métricas de backups (Prometheus)
# Ref: https://github.com/woblerr/pgbackrest_exporter
PGBACKREST_EXPORTER_IMAGE=woblerr/pgbackrest_exporter
PGBACKREST_EXPORTER_VERSION=latest

# =============================================================================
# ERPNEXT STACK - ERP/CRM Isolado
# =============================================================================

# ERPNext - ERP/CRM (Frappe Framework v15)
# Ref: https://github.com/frappe/erpnext/releases
ERPNEXT_VERSION=v15.95.2

# MariaDB - Database ERPNext
# Ref: https://hub.docker.com/_/mariadb/tags
# NOTA: ERPNext v15 requer MariaDB 10.8.x (não 11.x)
MARIADB_VERSION=10.8.8

# Redis ERPNext - Cache e Queue (versão 6.x obrigatória)
# Ref: https://hub.docker.com/_/redis/tags
# NOTA: ERPNext requer Redis 6.x para compatibilidade
REDIS_ERPNEXT_VERSION=6.2.21-alpine

# =============================================================================
# UTILITÁRIOS
# =============================================================================

# BusyBox - Utilitários minimalistas
# Ref: https://hub.docker.com/_/busybox/tags
BUSYBOX_VERSION=1.36.1

# PostgreSQL + pgvector (tag para build)
PGVECTOR_TAG=pg16

# =============================================================================
# DEPRECATED - Mantidos para compatibilidade (usar variáveis específicas acima)
# =============================================================================
# REDIS_VERSION está deprecated - usar REDIS_ALICE_VERSION ou REDIS_ERPNEXT_VERSION
REDIS_VERSION=7.4-alpine