      "title": "⚡ Ações Agentic",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 1,
      "title": "Ações por Status (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(alice_agentic_actions_total[5m])) by (action, status)",
          "legendFormat": "{{action}} • {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 2,
      "title": "Aprovações/Rejeições (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(alice_agentic_approvals_total[5m])) by (action, decision)",
          "legendFormat": "{{action}} • {{decision}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "id": 3,
      "title": "Latência P95 de Ações (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(alice_agentic_action_duration_seconds_bucket[5m])) by (le, action))",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ]
    }
  ],
