# Autor: Fillipe Guerra
# Data: 02/01/2026
#
# Configuração enterprise do Caddy reverse proxy:
# - SSL automático via Let's Encrypt (ACME)
# - Retry inteligente para evitar rate limits
# - HTTP/3 nativo (QUIC)
# - Security headers OWASP 2025
# - Rate limiting por rota
#
# Referência: https://caddyserver.com/docs/caddyfile
# =============================================================================

# =============================================================================
# CONFIGURAÇÃO GLOBAL
# =============================================================================
{
	# =================================================================
	# CORREÇÃO 03/01/2026: Email com Fallback para Fail-Safe
	# =================================================================
	# PROBLEMA: Caddy falha se ACME_EMAIL estiver vazio
	# SOLUÇÃO: Fallback para email válido (admin@yesyoudeserve.duckdns.org)
	# Permite validação do Caddyfile em CI sem envs
	# 
	# SINTAXE CORRETA: {$VAR:default} - usa default se VAR vazio
	# A opção 'email' precisa de valor no STARTUP para registro ACME
	# 
	# Email obrigatório em produção (ACME_EMAIL)
	# Fallback garante validação do Caddyfile em CI sem envs
	# Ref: https://caddyserver.com/docs/caddyfile/concepts#environment-variables
	# =================================================================
	email {$ACME_EMAIL}

	# Produção - Let's Encrypt oficial
	# NOTA: Caddy automaticamente usa staging para domínios localhost/local
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	
	# Storage persistente para certificados
	storage file_system {
		root /data
	}
	
	# Admin API (healthcheck interno)
	admin :2019
	
	# HTTP/3 habilitado globalmente (QUIC) + Métricas Prometheus
	# CORREÇÃO 20/01/2026: 'metrics' no bloco global (evita warning deprecado)
	# Ref: https://caddyserver.com/docs/caddyfile/options#metrics
	metrics
	servers {
		protocols h1 h2 h3
	}
	
	# Logs estruturados
	# CORREÇÃO 03/01/2026: Log level configurável via env var
	# LOG_LEVEL pode ser: DEBUG, INFO, WARN, ERROR (default: INFO)
	# Para troubleshooting: docker run -e LOG_LEVEL=DEBUG ...
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 168h
		}
		format json
		level {$LOG_LEVEL:INFO}
	}
}

# =============================================================================
# HEALTH ENDPOINT (Docker Healthcheck)
# =============================================================================
# Endpoint simples para verificação de saúde do container
# Responde em porta 80 sem requerer SSL ou DNS
# Ref: https://caddyserver.com/docs/caddyfile/directives/respond
:80 {
	handle /health {
		respond "OK" 200
	}
}

# =============================================================================
# SNIPPETS REUTILIZÁVEIS
# =============================================================================

# Security Headers (OWASP 2025)
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
		-Server
	}
}

# Proxy headers padrão
# CORREÇÃO 04/01/2026: Removidos X-Forwarded-For e X-Forwarded-Proto
# Caddy adiciona automaticamente esses headers, causando avisos desnecessários
# Ref: https://caddyserver.com/docs/caddyfile/directives/reverse_proxy#defaults
(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	# X-Forwarded-For e X-Forwarded-Proto são adicionados automaticamente pelo Caddy
}

# WebSocket headers
# CORREÇÃO 04/01/2026: Removidos X-Forwarded-For e X-Forwarded-Proto
# Caddy adiciona automaticamente esses headers, causando avisos desnecessários
(websocket_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	# X-Forwarded-For e X-Forwarded-Proto são adicionados automaticamente pelo Caddy
	header_up Connection {header.Connection}
	header_up Upgrade {header.Upgrade}
}

# TLS via DNS-01 (DuckDNS) + fallback ZeroSSL (EAB)
(tls_duckdns) {
	tls {
		issuer acme {
			dir https://acme.zerossl.com/v2/DV90
			dns duckdns {$DUCKDNS_TOKEN}
			resolvers 1.1.1.1 8.8.8.8
			eab {$ZEROSSL_EAB_KID} {$ZEROSSL_EAB_HMAC_KEY}
		}
		issuer acme {
			dns duckdns {$DUCKDNS_TOKEN}
			resolvers 1.1.1.1 8.8.8.8
		}
	}
}

# =============================================================================
# DOMÍNIO ÚNICO + WILDCARD (certificado único)
# =============================================================================
yesyoudeserve.duckdns.org, *.yesyoudeserve.duckdns.org {
	import tls_duckdns
	# Security headers em todas as respostas
	import security_headers

	# =========================================================================
	# ROOT DOMAIN - FRONTEND + APIs ALICE
	# =========================================================================
	@root host yesyoudeserve.duckdns.org
	handle @root {
		# Content Security Policy específica para SPA React
		header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' wss://yesyoudeserve.duckdns.org https:; frame-ancestors 'none'; upgrade-insecure-requests"

		# =========================================================================
		# OIDC Provider (Alice como IdP)
		# =========================================================================
		handle /.well-known/openid-configuration {
			reverse_proxy alice-auth:3001 {
				import proxy_headers
			}
		}

		handle /oauth/* {
			reverse_proxy alice-auth:3001 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Auth API (rate limit mais restritivo: 10 req/min)
		# =========================================================================
		handle /api/auth/* {
			reverse_proxy alice-auth:3001 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Users API (auth-service)
		# =========================================================================
		handle /api/users* {
			reverse_proxy alice-auth:3001 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Audit API (logs de auditoria - parte do auth-service)
		# CORREÇÃO 12/01/2026: Rota faltante causava 403 no Dashboard
		# =========================================================================
		handle /api/audit/* {
			reverse_proxy alice-auth:3001 {
				import proxy_headers
			}
		}

		# =========================================================================
		# WebSocket (streaming LLM)
		# =========================================================================
		handle /ws/* {
			reverse_proxy alice-chat:3002 {
				import websocket_headers
			}
		}

		# =========================================================================
		# Chat API
		# =========================================================================
		# CORREÇÃO 02/02/2026: Streaming SSE pode durar mais em modo agentic/LLM.
		# Ajuste de timeouts evita encerramento prematuro do stream pelo proxy.
		handle /api/chat/stream {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
				transport http {
					dial_timeout 15s
					read_timeout 5m
					write_timeout 10m
				}
			}
		}
		handle /api/chat/* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Chat API (rotas fora do prefixo /api/chat)
		# =========================================================================
		handle /api/namespaces* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}
		handle /api/agents* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}
		handle /api/assistant-settings* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}
		handle /api/agentic* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}
		handle /api/takeover* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}
		handle /api/llm* {
			reverse_proxy alice-chat:3002 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Media API (uploads/arquivos do RAG)
		# =========================================================================
		handle /api/media* {
			reverse_proxy alice-rag:3003 {
				import proxy_headers
			}
		}

		# =========================================================================
		# RAG API
		# =========================================================================
		handle /api/rag/* {
			reverse_proxy alice-rag:3003 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Training API
		# =========================================================================
		handle /api/training/* {
			reverse_proxy alice-training:3004 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Integrations API
		# =========================================================================
		# CORREÇÃO 02/02/2026: Geração de sinal LLM pode exceder 30s.
		# Timeout dedicado para evitar 502 no proxy.
		handle /api/integrations/trading/signals/generate {
			reverse_proxy alice-integrations:3005 {
				import proxy_headers
				transport http {
					dial_timeout 15s
					read_timeout 4m
					write_timeout 4m
				}
			}
		}
		# CORREÇÃO 04/02/2026: Análise com arbitragem pode ser mais lenta (CPU).
		# Timeout dedicado evita encerramento prematuro no proxy.
		handle /api/integrations/trading/analysis* {
			reverse_proxy alice-integrations:3005 {
				import proxy_headers
				transport http {
					dial_timeout 15s
					read_timeout 3m
					write_timeout 3m
				}
			}
		}
		handle /api/integrations/* {
			reverse_proxy alice-integrations:3005 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Webhook (Stripe, Wise, Twilio)
		# =========================================================================
		handle /webhook/* {
			reverse_proxy alice-integrations:3005 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Observability API
		# =========================================================================
		handle /api/observability/* {
			reverse_proxy alice-observability:3007 {
				import proxy_headers
			}
		}

		# =========================================================================
		# Frontend SPA React (fallback - todas as outras rotas)
		# =========================================================================
		handle {
			reverse_proxy alice-frontend:8080 {
				import proxy_headers
			}
		}
	}

	# =========================================================================
	# GRAFANA (Observability Dashboard)
	# =========================================================================
	@observability host observability.yesyoudeserve.duckdns.org
	handle @observability {
		reverse_proxy grafana:3000 {
			import proxy_headers
		}
	}

	# =========================================================================
	# PROMETHEUS (Métricas)
	# =========================================================================
	@metrics host metrics.yesyoudeserve.duckdns.org
	handle @metrics {
		reverse_proxy prometheus:9090 {
			import proxy_headers
		}
	}

	# =========================================================================
	# JAEGER (Distributed Tracing)
	# =========================================================================
	@traces host traces.yesyoudeserve.duckdns.org
	handle @traces {
		reverse_proxy jaeger:16686 {
			import proxy_headers
		}
	}

	# =========================================================================
	# LANGFUSE (LLM Observability)
	# =========================================================================
	@langfuse host langfuse.yesyoudeserve.duckdns.org
	handle @langfuse {
		reverse_proxy langfuse:3000 {
			import proxy_headers
		}
	}

	# =========================================================================
	# ERPNEXT (ERP/CRM)
	# =========================================================================
	@erpnext host erp.yesyoudeserve.duckdns.org
	handle @erpnext {
		# WebSocket ERPNext (socket.io)
		handle /socket.io/* {
			reverse_proxy erpnext-websocket:9000 {
				import websocket_headers
			}
		}

		# Frontend ERPNext (fallback)
		handle {
			reverse_proxy erpnext-frontend:8080 {
				import proxy_headers
			}
		}
	}
}
