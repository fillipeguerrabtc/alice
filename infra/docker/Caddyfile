	reverse_proxy langfuse-web:3000 {
		import proxy_headers
	}
}

# =============================================================================
# ERPNEXT (ERP/CRM)
# =============================================================================
erp.yesyoudeserve.duckdns.org {
	import security_headers
	
	# WebSocket ERPNext (socket.io)
	handle /socket.io/* {
		reverse_proxy erpnext-socketio:9000 {
			import websocket_headers
		}
	}
	
	# Frontend ERPNext (fallback)
	handle {
		reverse_proxy erpnext-frontend:8080 {
			import proxy_headers
		}
	}
}
