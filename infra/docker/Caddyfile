# =============================================================================
# Caddyfile - Alice Enterprise Platform
# =============================================================================
# Autor: Fillipe Guerra
# Data: 02/01/2026
#
# Configuração enterprise do Caddy reverse proxy:
# - SSL automático via Let's Encrypt (ACME)
# - Retry inteligente para evitar rate limits
# - HTTP/3 nativo (QUIC)
# - Security headers OWASP 2025
# - Rate limiting por rota
#
# Referência: https://caddyserver.com/docs/caddyfile
# =============================================================================

# =============================================================================
# CONFIGURAÇÃO GLOBAL
# =============================================================================
{
	# =================================================================
	# CORREÇÃO 03/01/2026: Email com Fallback para Fail-Safe
	# =================================================================
	# PROBLEMA: Caddy crashava se ACME_EMAIL estava vazio
	# SOLUÇÃO: Adicionar fallback para email válido (fillipe.backup@gmail.com)
	# Permite graceful degradation ao invés de crash total
	# 
	# SINTAXE CORRETA: {$VAR:default} - usa default se VAR vazio
	# A opção 'email' precisa de valor no STARTUP para registro ACME
	# 
	# Email fallback: fillipe.backup@gmail.com (mesmo usado em Grafana alerting)
	# Ref: https://caddyserver.com/docs/caddyfile/concepts#environment-variables
	# =================================================================
	email {$ACME_EMAIL:fillipe.backup@gmail.com}
	
	# Produção - Let's Encrypt oficial
	# NOTA: Caddy automaticamente usa staging para domínios localhost/local
	acme_ca https://acme-v02.api.letsencrypt.org/directory
	
	# Storage persistente para certificados
	storage file_system {
		root /data
	}
	
	# Admin API (healthcheck interno)
	admin :2019
	
	# HTTP/3 habilitado globalmente (QUIC) + Métricas Prometheus
	# CORREÇÃO 02/01/2026: 'metrics' deve estar DENTRO do bloco 'servers'
	# Ref: https://caddyserver.com/docs/caddyfile/options#servers
	servers {
		protocols h1 h2 h3
		metrics
	}
	
	# Logs estruturados
	log {
		output file /var/log/caddy/access.log {
			roll_size 100mb
			roll_keep 5
			roll_keep_for 168h
		}
		format json
		level INFO
	}
}

# =============================================================================
# SNIPPETS REUTILIZÁVEIS
# =============================================================================

# Security Headers (OWASP 2025)
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

# Proxy headers padrão
(proxy_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
}

# WebSocket headers
(websocket_headers) {
	header_up Host {host}
	header_up X-Real-IP {remote_host}
	header_up X-Forwarded-For {remote_host}
	header_up X-Forwarded-Proto {scheme}
	header_up Connection {header.Connection}
	header_up Upgrade {header.Upgrade}
}

# =============================================================================
# FRONTEND + APIs ALICE
# =============================================================================
yesyoudeserve.duckdns.org {
	# Security headers em todas as respostas
	import security_headers
	
	# Content Security Policy específica para SPA React
	header Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss://yesyoudeserve.duckdns.org https:; frame-ancestors 'none'; upgrade-insecure-requests"
	
	# =========================================================================
	# OIDC Provider (Alice como IdP)
	# =========================================================================
	handle /.well-known/openid-configuration {
		reverse_proxy alice-auth:3001 {
			import proxy_headers
		}
	}
	
	handle /oauth/* {
		reverse_proxy alice-auth:3001 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Auth API (rate limit mais restritivo: 10 req/min)
	# =========================================================================
	handle /api/auth/* {
		reverse_proxy alice-auth:3001 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# WebSocket (streaming LLM)
	# =========================================================================
	handle /ws/* {
		reverse_proxy alice-chat:3002 {
			import websocket_headers
		}
	}
	
	# =========================================================================
	# Chat API
	# =========================================================================
	handle /api/chat/* {
		reverse_proxy alice-chat:3002 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# RAG API
	# =========================================================================
	handle /api/rag/* {
		reverse_proxy alice-rag:3003 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Training API
	# =========================================================================
	handle /api/training/* {
		reverse_proxy alice-training:3004 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Integrations API
	# =========================================================================
	handle /api/integrations/* {
		reverse_proxy alice-integrations:3005 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Webhook (Stripe, Wise, Twilio)
	# =========================================================================
	handle /webhook/* {
		reverse_proxy alice-integrations:3005 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Observability API
	# =========================================================================
	handle /api/observability/* {
		reverse_proxy alice-observability:3007 {
			import proxy_headers
		}
	}
	
	# =========================================================================
	# Frontend SPA React (fallback - todas as outras rotas)
	# =========================================================================
	handle {
		reverse_proxy alice-frontend:8080 {
			import proxy_headers
		}
	}
}

# =============================================================================
# GRAFANA (Observability Dashboard)
# =============================================================================
observability.yesyoudeserve.duckdns.org {
	import security_headers
	
	reverse_proxy grafana:3000 {
		import proxy_headers
	}
}

# =============================================================================
