# =============================================================================
# ALICE PLATFORM - VARIÁVEIS DE AMBIENTE PRODUÇÃO
# =============================================================================
# IMPORTANTE: Copiar para .env.prod e preencher com valores reais
# NUNCA commitar o arquivo .env.prod no repositório!
# Após criar .env.prod, executar: chmod 600 .env.prod
# =============================================================================

# =============================================================================
# IMAGENS DOCKER - Gerado automaticamente pelo CI/CD
# =============================================================================
IMAGE_PREFIX=ghcr.io/<OWNER>/alice
IMAGE_TAG=latest

# =============================================================================
# POSTGRESQL - Banco de dados Alice
# =============================================================================
POSTGRES_USER=alice
POSTGRES_PASSWORD=GERAR_SENHA_FORTE_AQUI
POSTGRES_DB=alice_prod

# =============================================================================
# SESSÃO
# =============================================================================
SESSION_SECRET=GERAR_SECRET_32_CARACTERES_AQUI

# WebSocket token (ephemeral auth, falls back to SESSION_SECRET if not set)
WS_TOKEN_SECRET=
WS_TOKEN_TTL_SECONDS=60

# =============================================================================
# OAUTH - Google
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# OAUTH - GitHub (Prefixo OAUTH_ porque GITHUB_ é reservado)
# =============================================================================
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# =============================================================================
# GITHUB ACTIONS - Stack Ops (Agentic)
# =============================================================================
GH_PAT=
GH_REPO=
GH_API_URL=https://api.github.com

# =============================================================================
# OAUTH - Microsoft
# =============================================================================
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# =============================================================================
# SALAD CLOUD - LLM Infrastructure
# =============================================================================
SALAD_API_KEY=
SALAD_ORGANIZATION_ID=

# =============================================================================
# STRIPE - Pagamentos Portugal (EUR/SEPA)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# =============================================================================
# TWILIO - WhatsApp/SMS/Voice
# =============================================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# =============================================================================
# RESEND - Emails Transacionais
# =============================================================================
RESEND_API_KEY=

# =============================================================================
# ERPNEXT - ERP/CRM Self-hosted
# =============================================================================
ERPNEXT_SITE_NAME=erp.yesyoudeserve.duckdns.org
ERPNEXT_MYSQL_ROOT_PASSWORD=GERAR_SENHA_FORTE_AQUI
ERPNEXT_DB_NAME=erpnext
ERPNEXT_DB_USER=erpnext
ERPNEXT_DB_PASSWORD=GERAR_SENHA_FORTE_AQUI
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# =============================================================================
# GPU ORCHESTRATION (Modo simultâneo por padrão - coexistência em 20GB)
# =============================================================================
# simultaneous: não faz stop/start de containers GPU (recomendado)
# preemptive: mantém comportamento legado de troca trainer/embeddings
GPU_CONCURRENCY_MODE=simultaneous
GPU_RETRY_AFTER_SECONDS=5
GPU_TOTAL_VRAM_GB=20
GPU_VRAM_SAFETY_MARGIN_GB=2
GPU_VRAM_BUDGET_LLM=6
GPU_VRAM_BUDGET_EMBEDDINGS=3
GPU_VRAM_BUDGET_TRAINING=8
GPU_ADMISSION_MIN_FREE_GB_LLM=2
GPU_ADMISSION_MIN_FREE_GB_EMBEDDINGS=1.5
GPU_ADMISSION_MIN_FREE_GB_TRAINING=2
LLM_MAX_MODEL_LEN=4096
LLM_MAX_NUM_SEQS=8
LLM_MAX_NUM_BATCHED_TOKENS=1024
LLM_GPU_MEMORY_UTILIZATION=0.36
LLM_KV_CACHE_DTYPE=fp8
LLM_KV_OFFLOADING_SIZE_GB=0
LLM_KV_OFFLOADING_BACKEND=cpu
LLM_ENABLE_PREFIX_CACHING=true

# =============================================================================
# TRADING V2 (modo operacional institucional)
# =============================================================================
TRADING_MODE=portfolio_auto
TRADING_LLM_PROMPT_MODE=compact

# Backtest defaults (walk-forward / purge / embargo)
TRADING_WALK_FORWARD_WINDOWS=6
TRADING_PURGE_HORIZON_BARS=3
TRADING_EMBARGO_BARS=1

# Custos default (baseline) - pode ser sobrescrito por tenant/riskConfig
TRADING_COST_BASELINE_FEE_BPS=8
TRADING_COST_BASELINE_SLIPPAGE_BPS=12
TRADING_COST_BASELINE_SPREAD_BPS=5
