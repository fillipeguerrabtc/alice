{
  "name": "@alice/gpu-manager-service",
  "version": "1.0.0",
  "description": "GPU Manager Service - Gerenciamento centralizado de requisições GPU",
  "private": true,
  "type": "module",
  "main": "dist/bundle.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/build-service.mjs gpu-manager-service",
    "build:tsc": "tsc",
    "start": "node dist/bundle.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@alice/database": "workspace:*",
    "@alice/logger": "workspace:*",
    "@alice/shared-utils": "workspace:*",
    "express": "5.2.1",
    "cors": "2.8.5",
    "compression": "1.7.5",
    "zod": "3.25.42"
  },
  "devDependencies": {
    "@types/express": "5.0.2",
    "@types/cors": "2.8.19",
    "@types/compression": "1.7.5",
    "@types/node": "22.15.29",
    "esbuild": "^0.27.0",
    "typescript": "5.9.3",
    "tsx": "4.20.3"
  }
}
