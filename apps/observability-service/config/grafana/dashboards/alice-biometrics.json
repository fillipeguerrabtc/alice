{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Dashboard Biometria - login, status, enrollment e verificações",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 2,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Home",
      "type": "link",
      "url": "/d/alice-home/home"
    }
  ],
  "panels": [
    {
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "content": "# Biometria - Observabilidade\nMonitoramento das rotas de biometria (login, status, enrollment e verificação).",
        "mode": "markdown"
      },
      "transparent": true,
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 2 },
      "id": 2,
      "title": "📸 Fluxos de Biometria",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 3 },
      "id": 3,
      "title": "Requisições por rota (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(increase(alice_http_requests_total{route=~\"/api/auth/biometrics/(login|status|enroll|verify)\"}[5m])) by (route, status_code)",
          "legendFormat": "{{route}} • {{status_code}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 3 },
      "id": 4,
      "title": "Taxa de erro (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(alice_http_requests_total{route=~\"/api/auth/biometrics/(login|status|enroll|verify)\",status_code=~\"4..|5..\"}[5m])) / sum(rate(alice_http_requests_total{route=~\"/api/auth/biometrics/(login|status|enroll|verify)\"}[5m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" }
        }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 11 },
      "id": 5,
      "title": "Latência P95 por rota (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(alice_http_request_duration_seconds_bucket{route=~\"/api/auth/biometrics/(login|status|enroll|verify)\"}[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["alice", "biometrics", "auth"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Biometria",
  "uid": "alice-biometrics",
  "version": 1
}
