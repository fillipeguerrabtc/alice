{
  "name": "@alice/llm-gateway-service",
  "version": "1.0.0",
  "description": "LLM Gateway - Resolução de contexto namespace/agente e proxy para GPU Manager",
  "private": true,
  "type": "module",
  "main": "dist/bundle.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node ../../scripts/build-service.mjs llm-gateway-service",
    "build:tsc": "tsc",
    "start": "node dist/bundle.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@alice/config": "workspace:*",
    "@alice/database": "workspace:*",
    "@alice/logger": "workspace:*",
    "@alice/shared": "workspace:*",
    "@alice/shared-utils": "workspace:*",
    "compression": "1.8.1",
    "cors": "2.8.5",
    "drizzle-orm": "0.45.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.3.0",
    "helmet": "8.1.0",
    "opossum": "9.0.0",
    "pg": "8.16.3",
    "pgvector": "^0.2.1",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.10.2",
    "esbuild": "^0.27.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
