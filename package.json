  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index-dev.ts",
    "build": "cd apps/frontend-service && vite build --outDir ../../dist/public --emptyOutDir && cd ../.. && esbuild server/index-prod.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/index.js",
    "build:packages": "rm -rf packages/*/dist packages/*/*.tsbuildinfo && cd packages/shared && npx tsc -b --force && cd ../shared-utils && npx tsc -b --force && cd ../config && npx tsc -b --force && cd ../logger && npx tsc -b --force && cd ../database && npx tsc -b --force",
    "build:tsc": "rm -rf packages/*/dist packages/*/*.tsbuildinfo && tsc -b tsconfig.build.json --force",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "cd apps/frontend-service && pnpm run build",
    "db:push": "drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
