#!/bin/bash
# ==============================================================================
# Pre-commit Hook - Alice Enterprise Platform
#
# Verifica e bloqueia commits que incluam arquivos temporários do Cursor
# Também limpa automaticamente a pasta attached_assets/ antes do commit
#
# Instalação:
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Autor: Fillipe Guerra
# Data: 11 de Dezembro de 2025
# ==============================================================================

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}[pre-commit]${NC} Verificando arquivos temporários do Cursor..."

# Verificar se há arquivos da pasta attached_assets/ staged
ATTACHED_FILES=$(git diff --cached --name-only | grep "^attached_assets/" || true)

if [ -n "$ATTACHED_FILES" ]; then
    echo -e "${RED}[BLOQUEADO]${NC} Arquivos de attached_assets/ detectados no commit!"
    echo ""
    echo "Esses arquivos são temporários do Cursor IDE e não devem ser commitados:"
    echo "$ATTACHED_FILES" | while read file; do
        echo "  - $file"
    done
    echo ""
    echo "Removendo do staging area..."
    git reset HEAD attached_assets/ 2>/dev/null || true
    echo -e "${GREEN}[OK]${NC} Arquivos removidos do commit."
    echo ""
fi

# Limpar pasta attached_assets/ se existir
if [ -d "attached_assets" ]; then
    FILE_COUNT=$(find attached_assets -type f 2>/dev/null | wc -l)
    if [ "$FILE_COUNT" -gt 0 ]; then
        echo -e "${YELLOW}[pre-commit]${NC} Limpando attached_assets/ ($FILE_COUNT arquivos)..."
        rm -rf attached_assets
        echo -e "${GREEN}[OK]${NC} Pasta limpa!"
    fi
fi

echo -e "${GREEN}[pre-commit]${NC} Verificação concluída."
exit 0
