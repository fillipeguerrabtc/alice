# =============================================================================
# GitHub Actions Workflow - Deploy Enterprise (Self-Hosted Runner)
# =============================================================================
# EXEMPLO: Workflow usando self-hosted runner no Hetzner GPU Server
# Substitui deploy-production.yml após migração completa
# =============================================================================
# Benefícios:
# - Zero latência (execução local)
# - Sem SSH keys (usa OIDC tokens)
# - Cache local de imagens
# - Versionamento automático
# =============================================================================

name: Deploy to Production (Self-Hosted Runner)

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'Versão para deploy (ex: v1.0.0)'
        type: string
        required: true

concurrency:
  group: deploy-production
  cancel-in-progress: true

permissions:
  contents: read
  packages: write

env:
  IMAGE_PREFIX: ghcr.io/${{ github.repository_owner }}/alice

jobs:
  build-docker:
    name: Build Docker Images
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build and Push
        uses: docker/build-push-action@v5
        with:
          push: true
          tags: ${{ env.IMAGE_PREFIX }}-auth:${{ github.event.inputs.version }}

  deploy:
    name: Deploy Hetzner GPU Server
    runs-on: self-hosted  # Runner no Hetzner GPU Server
    needs: build-docker
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: ${{ github.event.inputs.version }}
          
      - name: Login GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ github.token }}
          
      - name: Generate .env.prod
        run: |
          cd /opt/alice/app
          chmod +x infra/scripts/generate-env-prod.sh
          ./infra/scripts/generate-env-prod.sh
        env:
          # Secrets injetadas automaticamente pelo GitHub Actions
          POSTGRES_PASSWORD_SECRET: ${{ secrets.POSTGRES_PASSWORD }}
          # ... outras secrets
          
      - name: Pull Images
        run: |
          cd /opt/alice/app/infra/docker
          docker compose pull
          
      - name: Deploy
        run: |
          cd /opt/alice/app/infra/docker
          docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --wait
          
      - name: Health Check
        run: |
          # Health checks locais (sem latência de rede)
          curl -f http://localhost:3001/api/auth/health || exit 1
          curl -f http://localhost:3002/api/chat/health || exit 1
          curl -f http://localhost:3010/live || exit 1  # GPU Manager

